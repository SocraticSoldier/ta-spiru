# Copy to the repo root as `.env` on the server, next to docker-compose.yml.
# NEVER commit the real file.

# Public identity
DOMAIN=app.taspiru.com
PUBLIC_URL=https://app.taspiru.com
ACME_EMAIL=admin@taspiru.com

# Database (internal to the compose network)
POSTGRES_USER=taspiru
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=taspiru

# API secrets
JWT_SECRET=generate-64-random-chars

# Trust Payments (from the MyST portal)
TRUST_PAYMENTS_SITE_REFERENCE=live_taspiru
TRUST_PAYMENTS_JWT_USERNAME=jwt@taspiru.com
TRUST_PAYMENTS_JWT_SECRET=from-myst-portal
TRUST_PAYMENTS_WEBHOOK_PASSWORD=from-myst-portal
