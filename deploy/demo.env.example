# Ta' Spiru — DEMO environment.
# Copy to the repo root as `.env`:  cp deploy/demo.env.example .env
# Then replace the two <generate> secrets. Trust Payments stays on demo
# placeholders — everything works except live card settlement (bookings
# stay "pending" instead of auto-confirming). Swap in real MyST values
# when you go fully live.

# Public identity
DOMAIN=app.taspiru.com
PUBLIC_URL=https://app.taspiru.com
ACME_EMAIL=admin@taspiru.com

# Database (internal to the compose network) — generate a strong password:
#   openssl rand -base64 48
POSTGRES_USER=taspiru
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=taspiru

# API session secret — generate:  openssl rand -hex 32
JWT_SECRET=<generate>

# Trust Payments — DEMO placeholders (no real settlement in demo mode).
# Replace with your MyST portal values to take live payments.
TRUST_PAYMENTS_SITE_REFERENCE=demo_taspiru
TRUST_PAYMENTS_JWT_USERNAME=demo@taspiru.com
TRUST_PAYMENTS_JWT_SECRET=demo-placeholder-not-for-real-payments
TRUST_PAYMENTS_WEBHOOK_PASSWORD=demo-placeholder-not-for-real-payments
