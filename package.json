{
  "name": "ta-spiru",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ta-spiru/database db:generate",
    "db:migrate": "pnpm --filter @ta-spiru/database db:migrate",
    "db:seed": "pnpm --filter @ta-spiru/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  }
}
