// Ta' Spiru Digital Ecosystem — multi-location schema (Phase 1)
// Money is stored in integer cents. Timestamps are UTC; opening hours are
// local wall-clock strings interpreted in Location.timezone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  ADMIN // global
  MANAGER // location-scoped
  RECEPTIONIST // location-scoped (POS / calendar)
  BARBER // personal
  WASH_ATTENDANT // personal / bay
  CUSTOMER
}

enum ServiceKind {
  BARBER
  WASH
}

// Barber experience band. Drives which service price/duration tier applies.
enum Seniority {
  JUNIOR
  NORMAL
  SENIOR
}

enum ResourceKind {
  BARBER_CHAIR
  WASH_BAY
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  LATE // client is running late — kept on the schedule, flagged on the kiosk
}

// Where a booking was created. Feeds the admin bookings audit.
enum BookingSource {
  ONLINE
  RECEPTION
  WALK_IN
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  LEFT
}

enum OrderChannel {
  ECOMMERCE
  POS
  BACK_BAR
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentChannel {
  ONLINE
  POS_TERMINAL
}

enum TransactionStatus {
  PENDING
  AUTHORISED
  SETTLED
  DECLINED
  REFUNDED
  CANCELLED
}

// Revenue-splitting tags mirrored in the Trust Payments settlement ledger.
enum LedgerTag {
  BARBER_SERVICES
  CAR_DETAILING
  RETAIL_BARBER
  RETAIL_CAR_CARE
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
}

enum LoyaltyEntryKind {
  EARN
  REDEEM
  ADJUST
}

enum ProductCategory {
  HAIR_CARE
  STYLING_WAX
  SHAVE_BEARD
  DETAILING_CHEMICAL
  DETAILING_HARDWARE
}

enum StockMovementKind {
  INTAKE
  SALE_ECOMMERCE
  SALE_POS
  BACK_BAR_USE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// ─────────────────────────────── Network ───────────────────────────────

model Location {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  address  String
  phone    String?
  timezone String  @default("Europe/Malta")
  isActive Boolean @default(true)

  openingHours      OpeningHours[]
  users             User[]
  services          LocationService[]
  resources         Resource[]
  shifts            Shift[]
  timeEntries       TimeEntry[]
  timeBlocks        TimeBlock[]
  appointments      Appointment[]
  queueEntries      QueueEntry[]
  waitingList       WaitingListEntry[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  orders            Order[]
  transactionSplits TransactionSplit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpeningHours {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  weekday    Int // 0 = Sunday … 6 = Saturday; absent row = closed
  opensAt    String // "HH:mm" local time
  closesAt   String // "HH:mm" local time

  @@unique([locationId, weekday])
}

// ─────────────────────────────── People ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  passwordHash String? // null for customers created via guest checkout
  pinHash      String? // staff timeclock PIN (bcrypt)
  firstName    String
  lastName     String
  role         Role      @default(CUSTOMER)
  locationId   String? // null = global (ADMIN) or unaffiliated (CUSTOMER)
  location     Location? @relation(fields: [locationId], references: [id])
  isActive     Boolean   @default(true)

  seniority Seniority? // barbers only — selects the service price/duration tier
  stationNo Int? // barber chair / station number (shown to customers too)
  photoUrl  String? // profile photo, shown on the customer booking screen

  shifts               Shift[]
  timeEntries          TimeEntry[]
  barberAppointments   Appointment[]   @relation("AppointmentBarber")
  customerAppointments Appointment[]   @relation("AppointmentCustomer")
  queueEntries         QueueEntry[]
  stockMovements       StockMovement[]
  orders               Order[]
  transactions         Transaction[]
  loyaltyAccount       LoyaltyAccount?
  timeBlocks           TimeBlock[]     @relation("TimeBlockBarber")
  createdTimeBlocks    TimeBlock[]     @relation("TimeBlockCreator")
  serviceOverrides     TeamMemberService[]
  waitingListEntries   WaitingListEntry[] @relation("WaitingListCustomer")
  waitingListRequests  WaitingListEntry[] @relation("WaitingListBarber")
  serviceChanges       ServiceChangeLog[] @relation("ServiceChangeActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, role])
}

// Attendance punch pair recorded from the in-store kiosk (PIN clock-in).
model TimeEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  clockInAt  DateTime  @default(now())
  clockOutAt DateTime? // null = currently clocked in

  @@index([userId, clockInAt])
  @@index([locationId, clockInAt])
}

// Admin-managed unavailability: a barber's break, or a whole-location
// closure when barberId is null. Availability engines exclude these windows.
model TimeBlock {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  barberId    String? // null = blocks the entire location (chairs and bays)
  barber      User?    @relation("TimeBlockBarber", fields: [barberId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  createdById String?
  createdBy   User?    @relation("TimeBlockCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId, startsAt])
  @@index([barberId, startsAt])
}

// Rostered working window; barbers are only bookable inside a shift.
model Shift {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime

  @@index([userId, startsAt])
  @@index([locationId, startsAt])
}

// ─────────────────────────────── Capacity ───────────────────────────────

// Physical bookable capacity: barber chairs and wash bays.
model Resource {
  id         String       @id @default(cuid())
  locationId String
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind       ResourceKind
  name       String
  isActive   Boolean      @default(true)

  appointments Appointment[]

  @@unique([locationId, name])
  @@index([locationId, kind])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Service {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  description     String?
  photoUrl        String? // shown in the service pop-up on the booking screen
  kind            ServiceKind
  durationMin     Int // default duration; barber tiers/overrides may change it
  priceCents      Int // default (NORMAL) price; barber tiers/overrides may change it
  ledgerTag       LedgerTag
  sortOrder       Int         @default(0) // display order in the app
  isComboEligible Boolean     @default(false)
  isActive        Boolean     @default(true)
  isQuoteOnly     Boolean     @default(false) // price given on inspection (e.g. ceramic coating)

  locations       LocationService[]
  appointments    Appointment[]
  queueEntries    QueueEntry[]
  tiers           ServiceTier[]
  memberOverrides TeamMemberService[]
  waitingList     WaitingListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WaitingListStatus {
  WAITING
  OFFERED // reception has offered a freed slot
  BOOKED // converted into an appointment
  CANCELLED
}

// A customer who wants a fully-booked barber on a given day. Reception works
// this list when a slot frees up; customers join it from the booking screen.
model WaitingListEntry {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customerId String
  customer   User              @relation("WaitingListCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  barberId   String? // null = happy with any barber
  barber     User?             @relation("WaitingListBarber", fields: [barberId], references: [id])
  serviceId  String
  service    Service           @relation(fields: [serviceId], references: [id])
  forDate    DateTime // the day the customer wants (date-only, UTC midnight)
  status     WaitingListStatus @default(WAITING)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, forDate, status])
  @@index([barberId, forDate, status])
}

// Per-seniority price/duration for a barber service (Junior / Normal / Senior).
model ServiceTier {
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  seniority   Seniority
  priceCents  Int
  durationMin Int
  serviceNo   String? // distinct service number per variation

  @@id([serviceId, seniority])
}

// A specific barber's configuration of a service: enable/disable, price &
// duration overrides, and a daily cap. Mirrors the team-member services grid
// (ENABLED / PRICE / DURATION / MAX DAILY) from the existing system.
model TeamMemberService {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isEnabled   Boolean  @default(true)
  priceCents  Int? // override; falls back to the seniority tier, then service default
  durationMin Int? // override; falls back to the seniority tier, then service default
  maxDaily    Int? // once reached, this barber takes no more of this service that day

  @@id([userId, serviceId])
  @@index([serviceId])
}

model LocationService {
  locationId         String
  location           Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serviceId          String
  service            Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceCentsOverride Int?
  isActive           Boolean  @default(true)

  @@id([locationId, serviceId])
}

// ─────────────────────────────── Inventory ───────────────────────────────

model Product {
  id         String          @id @default(cuid())
  sku        String          @unique
  barcode    String?         @unique // EAN/UPC for camera scanning (Phase 2)
  name       String
  brand      String?
  category   ProductCategory
  priceCents Int
  costCents  Int?
  ledgerTag  LedgerTag
  isActive   Boolean         @default(true)

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Current on-hand quantity per branch; the movement table is the ledger of record.
model StockLevel {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId       String
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity         Int      @default(0)
  reorderThreshold Int      @default(0)

  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
}

// Append-only central inventory ledger across e-commerce, POS and back-bar use.
model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind          StockMovementKind
  quantityDelta Int // negative = deduction
  reference     String? // orderId / appointmentId / transfer batch id
  note          String? // free-text reason (adjustments, back-bar use)
  performedById String?
  performedBy   User?             @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, locationId, createdAt])
}

// ─────────────────────────────── Booking ───────────────────────────────

model Appointment {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  customerId String
  customer   User              @relation("AppointmentCustomer", fields: [customerId], references: [id])
  serviceId  String
  service    Service           @relation(fields: [serviceId], references: [id])
  barberId   String? // set on BARBER segments
  barber     User?             @relation("AppointmentBarber", fields: [barberId], references: [id])
  resourceId String? // chair or wash bay
  resource   Resource?         @relation(fields: [resourceId], references: [id])
  status     AppointmentStatus @default(PENDING_PAYMENT)

  startsAt    DateTime
  endsAt      DateTime // actual service window
  lockedUntil DateTime // resource hold; wash segments extend past endsAt by the combo buffer

  comboGroupId String? // shared by both segments of a "Combo Wash & Cut"

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  priceCentsSnapshot Int? // price charged at booking, after barber seniority/overrides
  source             BookingSource @default(ONLINE) // audit: where it was booked from

  vehicleReg String? // wash segments
  notes      String?

  serviceChanges ServiceChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, startsAt])
  @@index([barberId, startsAt])
  @@index([resourceId, startsAt])
  @@index([comboGroupId])
}

// A barber changed the services of a live appointment (added a beard mid-cut,
// swapped a service, …). Every entry notifies the admin dashboard — both the
// anti-theft angle and the positive upsell report read from this log.
model ServiceChangeLog {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedById   String
  changedBy     User        @relation("ServiceChangeActor", fields: [changedById], references: [id])
  action        String // ADDED | REMOVED
  serviceName   String
  priceCents    Int // price delta the change introduced
  minutes       Int // duration delta
  overlapAccepted Boolean @default(false) // barber accepted the responsibility pop-up
  acknowledged  Boolean  @default(false) // admin has seen it
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([acknowledged])
}

// Live walk-in queue; ordering is joinedAt within WAITING status.
model QueueEntry {
  id          String      @id @default(cuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customerId  String? // null for manually-created walk-ins
  customer    User?       @relation(fields: [customerId], references: [id])
  displayName String
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id])
  serviceKind ServiceKind
  status      QueueStatus @default(WAITING)
  vehicleReg  String?

  joinedAt    DateTime  @default(now())
  calledAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  @@index([locationId, status, joinedAt])
}

// ─────────────────────────────── Retail ───────────────────────────────

model Order {
  id         String       @id @default(cuid())
  locationId String // fulfilment branch (stock is deducted here)
  location   Location     @relation(fields: [locationId], references: [id])
  customerId String?
  customer   User?        @relation(fields: [customerId], references: [id])
  channel    OrderChannel
  status     OrderStatus  @default(PENDING_PAYMENT)
  totalCents Int

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  items         OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, createdAt])
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  ledgerTag      LedgerTag
}

// ─────────────────────────────── Loyalty ───────────────────────────────

// Cross-business loyalty: points accrue on settled spend across services and retail.
model LoyaltyAccount {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  balancePoints   Int         @default(0)
  lifetimePoints  Int         @default(0)
  tier            LoyaltyTier @default(BRONZE)
  walletPassToken String      @unique @default(cuid()) // encoded in the Apple/Google Wallet pass QR

  entries LoyaltyLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoyaltyLedgerEntry {
  id          String           @id @default(cuid())
  accountId   String
  account     LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        LoyaltyEntryKind
  deltaPoints Int // negative = redemption
  reference   String? // transactionId / manual note reference
  note        String?

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ─────────────────────────────── Payments ───────────────────────────────

// One Trust Payments authorisation; may settle several appointments and orders.
model Transaction {
  id                   String            @id @default(cuid())
  paymentReference     String            @unique @default(cuid()) // sent to Trust Payments as `orderreference`
  transactionReference String?           @unique // Trust Payments' own reference, set by the webhook
  siteReference        String
  channel              PaymentChannel
  status               TransactionStatus @default(PENDING)
  currency             String            @default("EUR")
  amountCents          Int

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  rawWebhookPayload Json?

  appointments Appointment[]
  orders       Order[]
  splits       TransactionSplit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  @@index([status, createdAt])
}

// Revenue split ledger: the sum of a transaction's splits equals amountCents.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ledgerTag     LedgerTag
  amountCents   Int
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])

  @@index([transactionId])
  @@index([ledgerTag])
}
